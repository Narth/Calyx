{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Ledger Record v1",
  "type": "object",
  "required": ["ts_utc", "event_name", "severity", "prev_hash", "record_hash"],
  "additionalProperties": true,
  "properties": {
    "ts_utc": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T[\\d:.]+Z?$" },
    "event_name": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "wo_id": { "type": "string" },
    "context_tag": { "type": "string" },
    "payload_hash": { "type": "string" },
    "payload_summary": { "type": "string" },
    "prev_hash": { "type": ["string", "null"] },
    "record_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
