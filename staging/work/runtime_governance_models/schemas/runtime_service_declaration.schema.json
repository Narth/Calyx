{
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "runtime_service_declaration",
      "default": "runtime_service_declaration",
      "title": "Artifact Type",
      "type": "string"
    },
    "authoritative_runtime_role": {
      "enum": [
        "authoritative_writer",
        "health_enrichment_sampler",
        "launcher_wrapper",
        "effective_service_runtime",
        "runtime_supervisor",
        "bridge_cycle_owner",
        "bridge_idle_monitor",
        "duplicate_peer"
      ],
      "title": "Authoritative Runtime Role",
      "type": "string"
    },
    "expected_runtime_roles": {
      "items": {
        "enum": [
          "authoritative_writer",
          "health_enrichment_sampler",
          "launcher_wrapper",
          "effective_service_runtime",
          "runtime_supervisor",
          "bridge_cycle_owner",
          "bridge_idle_monitor",
          "duplicate_peer"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Runtime Roles",
      "type": "array"
    },
    "launch_notice_required": {
      "title": "Launch Notice Required",
      "type": "boolean"
    },
    "multiplicity_posture": {
      "enum": [
        "single_instance_only",
        "wrapper_child_expected",
        "bounded_multiplicity_optional",
        "bounded_multiplicity_required"
      ],
      "title": "Multiplicity Posture",
      "type": "string"
    },
    "schema_name": {
      "const": "runtime.service_declaration",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_name": {
      "enum": [
        "station_health_loop",
        "bridge_overseer"
      ],
      "title": "Service Name",
      "type": "string"
    },
    "topology_class": {
      "enum": [
        "single_process",
        "wrapper_child_runtime_pair",
        "bounded_multi_surface_runtime"
      ],
      "title": "Topology Class",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "artifact_id",
    "service_name",
    "topology_class",
    "multiplicity_posture",
    "authoritative_runtime_role",
    "expected_runtime_roles",
    "launch_notice_required"
  ],
  "title": "RuntimeServiceDeclaration",
  "type": "object"
}
