      "type": "string"
    },
    "manual_override_allowed": {
      "default": false,
      "title": "Manual Override Allowed",
      "type": "boolean"
    },
    "multiplicity_posture": {
      "enum": [
        "single_instance_only",
        "single_wrapper_child_pair_only",
        "bounded_multi_instance",
        "bounded_multi_pair",
        "unclassified_no_launch_without_review"
      ],
      "title": "Multiplicity Posture",
      "type": "string"
    },
    "notes": {
      "minLength": 1,
      "title": "Notes",
      "type": "string"
    },
    "permitted_multiplicity_count": {
      "minimum": 0,
      "title": "Permitted Multiplicity Count",
      "type": "integer"
    },
    "schema_name": {
      "const": "runtime.service_declaration.reconciliation",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_name": {
      "enum": [
        "station_health_loop",
        "bridge_overseer",
        "navigator_triage_loop",
        "cp6_cp7_loop",
        "energy_churn_cp9_loop",
        "service_failure_watch",
        "cli_avatar",
        "test_bounded_worker"
      ],
      "title": "Service Name",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "declaration_id",
    "service_name",
    "expected_topology_class",
    "multiplicity_posture",
    "permitted_multiplicity_count",
    "equivalence_matchers",
    "notes"
  ],
  "title": "RuntimeServiceDeclaration",
  "type": "object"
}
