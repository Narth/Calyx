# Station Calyx / CBO Hub — configuration template
# Copy to .env.cbo and fill in values. Do not commit .env.cbo (gitignored).
# See docs/USAGE_AND_HEALTH.md for cost-rate variables.

# --- Path overrides (optional) ---
# CALYX_REPO_ROOT=/path/to/repo   # Override repo root; default: auto-detect from app location
# CALYX_RUNTIME_DIR=runtime      # Override runtime dir; default: {repo}/runtime

# --- API keys (required for model roles) ---
# ANTHROPIC_API_KEY=              # Required for architect role
# OPENAI_API_KEY=                 # Required for workhorse role
# KIMI_API_KEY=                   # Required for second_opinion role (or MOONSHOT_API_KEY)

# --- Model IDs ---
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OPENAI_MODEL=gpt-5.1
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=                     # e.g. kimi-k2.5 (or KIMI_MODEL_ID)
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL_ID=             # e.g. llama3.2, tinyllama (required for local role)

# --- Cost rates ($ per million tokens, optional) ---
# See docs/USAGE_AND_HEALTH.md. Set only what you need for cost estimates.
# ANTHROPIC_INPUT_PER_MILLION=
# ANTHROPIC_OUTPUT_PER_MILLION=
# OPENAI_INPUT_PER_MILLION=
# OPENAI_OUTPUT_PER_MILLION=
# KIMI_INPUT_PER_MILLION=
# KIMI_OUTPUT_PER_MILLION=

# --- CBO Core optional ---
# CBO_STATE_CACHE_SEC=30         # Seconds to cache STATE.md; 0=off
# CBO_TOOL_LOOP_MAX=3           # Max tool calls per chat (1-5)

# --- Carbon intensity (optional) ---
# ELECTRICITY_MAPS_API_KEY=      # For load-shifting; get at app.electricitymaps.com
# CARBON_INTENSITY_ZONE=US       # e.g. US-SW-AZPS

# --- Telemetry Gateway ---
# CBO_CHAT_URL=http://127.0.0.1:7778/chat
# TELEMETRY_SECRET=              # Shared secret for remote clients

# --- Energy churn / build ready notification ---
# DISCORD_CHURN_WEBHOOK_URL=     # Discord webhook for build-ready signal (create in channel settings)
